    {
      "name": "Phase Beacon + Timer Display",
      "kind": "custom",
      "refersTo": "timer-display",
      "description": "Signature instrument: phase beacon strip, oversized mono digits, status chip.",
      "html": "<div class=\"ds-timer\"><div class=\"ds-beacon green\"></div><div class=\"ds-timer-display green\">02:00</div><div class=\"ds-timer-status\">READY</div></div>",
      "css": ".ds-timer{display:flex;flex-direction:column;align-items:center;gap:1rem;font-family:system-ui,Avenir,Helvetica,Arial,sans-serif}.ds-beacon{width:min(12rem,40vw);height:4px;border-radius:999px;background:currentColor;box-shadow:0 0 12px currentColor}.ds-beacon.green,.ds-timer-display.green{color:#4CAF50}.ds-beacon.yellow,.ds-timer-display.yellow{color:#FFC107}.ds-beacon.red,.ds-timer-display.red{color:#F44336}.ds-timer-display{font-family:'Courier New',Courier,monospace;font-size:clamp(4.5rem,30vw,18rem);font-weight:700;line-height:1;letter-spacing:-0.02em;font-variant-numeric:tabular-nums;white-space:nowrap;text-align:center;text-shadow:3px 3px 6px rgba(0,0,0,.3)}.ds-timer-status{font-size:clamp(1rem,3vw,1.35rem);font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#d0d0d0;padding:.5rem 1rem;border-radius:5px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18)}"
    },
    {
      "name": "Duration Button",
      "kind": "button",
      "refersTo": "duration-btn",
      "description": "Idle-only work length chip with aria-pressed.",
      "html": "<button class=\"ds-duration-btn ds-duration-btn-active\" aria-pressed=\"true\">2 MIN</button> <button class=\"ds-duration-btn\" aria-pressed=\"false\">3 MIN</button>",
      "css": ".ds-duration-btn{font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;font-size:clamp(.85rem,2.2vw,1.05rem);font-weight:700;border:none;border-radius:8px;cursor:pointer;background:#f0f0f0;color:#242424;transition:all .2s ease;box-shadow:0 2px 4px rgba(0,0,0,.12);min-height:44px;padding:.65rem 1.2rem}.ds-duration-btn:hover:not(:disabled){background:#e0e0e0;transform:translateY(-2px);box-shadow:0 4px 8px rgba(0,0,0,.22)}.ds-duration-btn:focus-visible{outline:3px solid #fff;outline-offset:2px}.ds-duration-btn:disabled{opacity:.45;cursor:not-allowed}.ds-duration-btn-active{background:#2E7D32;color:#fff;box-shadow:0 4px 8px rgba(46,125,50,.35)}"
    },
