  "narrative": {
    "northStar": "The Gym Floor Beacon",
    "overview": "Interval Timer is a single-surface workout instrument, not a productivity dashboard. Oversized mono digits dominate the viewport, a short phase beacon strip signals the active work/warning/cooldown state, and controls stay large, few, and low in the frame. Personality is direct, athletic, and glanceable—clarity under motion beats quiet sophistication.\n\nDensity is intentionally sparse: one non-scrolling full-viewport column, timer stage above, control deck below. Near-flat surfaces; hover lift and a digit text-shadow are the only resting-depth vocabulary. Motion marks urgency only (pulse on warning, flash on cooldown), with a static outline + beacon alternative under prefers-reduced-motion.",
    "keyCharacteristics": [
      "Full-viewport instrument layout (no scroll)",
      "Phase color is state language (work / warning / cooldown)",
      "Monospaced tabular digits, never mid-string wrapped",
      "Controls are chunky, uppercase, ≥44px, with visible focus rings",
      "Light and dark canvases each use composed phase values (deep variants on light)"
    ],
    "rules": [
      {
        "name": "The Phase Is Palette Rule",
        "body": "Work/warning/cooldown hues are reserved for phase state and the matching control.",
        "section": "colors"
      },
      {
        "name": "The One State Color Rule",
        "body": "Digits carry exactly one phase color at a time.",
        "section": "colors"
      },
      {
        "name": "The Composed Themes Rule",
        "body": "Light mode is not an invert—phase values step deeper for contrast.",
        "section": "colors"
      },
      {
        "name": "The Digit Monopoly Rule",
        "body": "Mono is for the countdown; labels stay in the system stack.",
        "section": "typography"
      },
      {
        "name": "The Tabular Instrument Rule",
        "body": "Digits use tabular numerals and never wrap mid-string.",
        "section": "typography"
      },
      {
        "name": "The Hover-Only Lift Rule",
        "body": "No permanent elevated panels.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use CSS variables for phase/canvas/control roles.",
      "Do keep digits nowrap + tabular-nums.",
      "Do provide reduced-motion phase cues that still read as urgency.",
      "Do keep ≥44px targets and visible focus rings.",
      "Do use deeper phase hues on the light canvas."
    ],
    "donts": [
      "Don't reintroduce Vite scaffold colors or page max-width chrome.",
      "Don't rely on scale/opacity loops as the only phase signal.",
      "Don't decorate with phase hues outside state/action meaning.",
      "Don't break the countdown string across lines."
    ]
  }
}
